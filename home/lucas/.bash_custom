# Bash prompt.
	
	# Bold colours.
	GREEN_BD="\[\e[1;38;5;034m\]"
	YELLOW_BD="\[\e[1;38;5;220m\]"
	YELLOW2_BD="\[\e[1;38;5;226m\]"
	RED_BD="\[\e[1;38;5;196m\]"
	SKYBLUE_BD="\[\e[1;38;5;027m\]"
	PINK_BD="\[\e[1;38;5;212m\]"

	# Miscellaneous.
	RESET="\[\033[0;0m\]"
	
	# Prompt format.
	PS1="${RED_BD}[${RESET}${YELLOW_BD}\u${RESET}${GREEN_BD}@${RESET}${SKYBLUE_BD}\h${RESET} ${PINK_BD}\w${RESET}${RED_BD}]${RESET} ${YELLOW2_BD}⚡${RESET} "

# Variables.
DOCUMENTS_FOLDER="$(xdg-user-dir DOCUMENTS)"
CONFIG_FOLDER="$HOME/.config"
GITHUB_FOLDER="$DOCUMENTS_FOLDER/GitHub"

# Aliases.

	# Directories.
	alias gitdir="cd $GITHUB_FOLDER"

	# Scripts.
	alias copy="cd $GITHUB_FOLDER/scripts/python && python copyconfigs.py && cd"
	alias adbscript="cd $GITHUB_FOLDER/scripts/python && python adbscript.py && cd"
	alias genscript="cd $GITHUB_FOLDER/scripts/python && python genscript.py && cd"

	# Miscellaneous.
	alias battery="cat /sys/class/power_supply/BAT*/capacity"
	alias makepdf="magick \*.png my_pdf.pdf"
	alias jpgpdf="mogrify -resize 30% *.jpg && magick *.jpg my_pdf.pdf"
	alias wikibot="cd DOCUMENTS_FOLDER/bot && source bin/activate && python pwb.py login"
	alias zljhx="zellij --layout $CONFIG_FOLDER/zellij/helix.kdl"

# Functions.
scrub_patch() {
	# Taken from: https://devmanual.gentoo.org/ebuild-writing/misc-files/patches/index.html
	sed -i \
		-e '/^index /d' \
		-e '/^new file mode /d' \
		-e '/^Index:/d' \
		-e '/^=========/d' \
		-e '/^RCS file:/d' \
		-e '/^retrieving/d' \
		-e '/^diff/d' \
		-e '/^Files .* differ$/d' \
		-e '/^Only in /d' \
		-e '/^Common subdirectories/d' \
		-e '/^deleted file mode [0-9]*$/d' \
		-e '/^+++/s:\t.*::' \
		-e '/^---/s:\t.*::' \
		"$@"
}
